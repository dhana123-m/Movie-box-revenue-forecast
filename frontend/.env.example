# Base URL of the backend API (leave blank in dev: the Vite proxy forwards /api to http://localhost:8000)
VITE_API_BASE_URL=

# Override only if the backend is hosted elsewhere, e.g.:
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_API_BASE_URL=https://movie-box-office-backend.onrender.com/api
