# Copy this file to `.env` (backend) and adjust as needed.
# All variables are optional — sensible defaults are built into the app.

# --- Server ---
APP_NAME=Movie Box Office Revenue Forecast API
VERSION=1.0.0
ENVIRONMENT=development

# --- Database (SQLite by default; SQLAlchemy URL) ---
# DATABASE_URL=sqlite:///./movie_box.db

# --- Model & artifacts (paths relative to the backend/ directory) ---
# MODEL_PATH=models/revenue_model.keras
# PREPROCESSOR_PATH=models/preprocessor.pkl
# METRICS_PATH=models/metrics.json
# METADATA_PATH=models/model_metadata.json
# FEATURE_CONFIG_PATH=models/feature_config.json

# --- Static frontend (optional) ---
# When this folder contains a production build (frontend/dist after `npm run
# build`), FastAPI serves the React app on the same port with SPA fallback.
# FRONTEND_DIST_PATH=../frontend/dist

# --- Training ---
# EPOCHS=120
# BATCH_SIZE=32
# LEARNING_RATE=0.001
# VALIDATION_SPLIT=0.15
# TEST_SPLIT=0.15
# RANDOM_SEED=42

# --- Behavior ---
# Allow triggering retraining from the UI (dev only).
ALLOW_RETRAIN=true
# USD -> INR rate used for the rupee estimate.
# INR_PER_USD=83.0
# Max CSV upload size in bytes (5 MB default).
# MAX_UPLOAD_BYTES=5242880

# --- CORS (comma separated origins) ---
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
